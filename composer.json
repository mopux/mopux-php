{
    "name": "mopux/mopux-php",
    "description": "Official PHP client for the Mopux API, with first-class Laravel integration.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "mopux",
        "api",
        "sdk",
        "client",
        "laravel",
        "project-management",
        "tasks"
    ],
    "homepage": "https://www.mopux.com",
    "authors": [
        {
            "name": "Mopux",
            "homepage": "https://www.mopux.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP client used by default when available.",
        "laravel/framework": "Enables the service provider, facade and testing fake."
    },
    "autoload": {
        "psr-4": {
            "Mopux\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mopux\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:integration": "pest --group=integration",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "sync-spec": "@php bin/sync-spec.php",
        "test:contract": "pest --testsuite=Contract"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "sync-spec": "Copy the public OpenAPI spec from the Mopux repository (override the source with MOPUX_SPEC).",
        "test:contract": "Check that every operation of resources/openapi.yaml is covered by the SDK."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mopux\\Laravel\\MopuxServiceProvider"
            ],
            "aliases": {
                "Mopux": "Mopux\\Laravel\\Facades\\Mopux"
            }
        }
    }
}
