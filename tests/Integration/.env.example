# Copy to tests/Integration/.env (git-ignored) or export these variables, then run
#   composer test:integration
#
# The suite creates a project with a group, tasks, comments and a document in the
# tenant, checks every write, and deletes the project at the end. Use a local or
# staging tenant, never production. The user needs API access and permission to
# manage projects.

MOPUX_INTEGRATION_URL=https://mopux.mopux-com.test
MOPUX_INTEGRATION_TOKEN=
# Or, instead of a token, credentials to log in (the token is revoked at the end):
MOPUX_INTEGRATION_EMAIL=
MOPUX_INTEGRATION_PASSWORD=
# Set to 1 for local certificates that are not trusted (e.g. *.test).
MOPUX_INTEGRATION_INSECURE=1
# Optional: host or IP to connect to instead of the URL's host, e.g. the web server
# container when PHP runs in a container where *.test resolves to localhost (lerd: lerd-nginx).
MOPUX_INTEGRATION_RESOLVE=
# Set to 0 to skip document uploads (e.g. when the tenant storage is not initialized).
MOPUX_INTEGRATION_UPLOADS=1
